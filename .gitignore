# Copy this to .gitignore at the repository root.
# It keeps three things out of the public repository: credentialed/patient data,
# local environment cruft, and run output. Reviewers reproduce results by running
# the code against their OWN credentialed data copy -- never against committed data.

# --- credentialed / restricted data (NEVER commit) ---
data/
raw/
*.csv
*.csv.gz
*.parquet
*.dta
*.sas7bdat
*.xlsx
*.xls
*.pkl
*.pickle
*.db
*.sqlite
*.sqlite3
*.h5
*.hdf5
*.feather
mimic*/
physionet*/
*phi*
*identifiable*

# --- run output (regenerated by running the code) ---
output/
outputs/
results/
tables/
logs/
figures/*.png
figures/*.pdf
figures/*.tiff
*.log

# --- python env ---
venv/
.venv/
env/
__pycache__/
*.pyc
.ipynb_checkpoints/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- secrets / config ---
.env
*.key
credentials*
config.local*

# --- os / editor junk ---
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
